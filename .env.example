SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ticket?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&rewriteBatchedStatements=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace-with-db-password
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
# false: 로컬 Redis/Valkey 및 검증한 ElastiCache Valkey 환경(README 기준).
# 전송 중 암호화(TLS)가 켜진 ElastiCache는 true로 설정한다. (application-prod.yaml 기본값은 true)
SPRING_DATA_REDIS_SSL_ENABLED=false
JWT_SECRET=replace-with-secret-key-at-least-32-bytes
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
TICKET_PURCHASE_STRATEGY=distributed
