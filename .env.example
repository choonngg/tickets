SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ticket?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&rewriteBatchedStatements=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace-with-db-password
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
# false: 로컬 Redis/Valkey 및 검증한 ElastiCache Valkey 환경(README 기준).
# 전송 중 암호화(TLS)가 켜진 ElastiCache는 true로 설정한다. (application-prod.yaml 기본값은 true)
SPRING_DATA_REDIS_SSL_ENABLED=false
# RS256 키쌍: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#             openssl pkey -in private.pem -pubout -out public.pem
# PEM은 개행을 \n 두 글자로 바꿔 한 줄로 넣는다. 환경마다 다른 키를 쓰고, 키를 바꾸면 JWT_KEY_ID도 바꾼다.
JWT_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nreplace-with-base64\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\nreplace-with-base64\n-----END PUBLIC KEY-----
JWT_KEY_ID=replace-with-key-id
# 대기열 Entry Token(RS256) 키쌍. 로그인용 JWT_* 키와 반드시 다른 키쌍을 새로 생성한다(생성법은 위와 동일). 키를 바꾸면 QUEUE_JWT_KEY_ID도 바꾼다.
QUEUE_JWT_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nreplace-with-base64\n-----END PRIVATE KEY-----
QUEUE_JWT_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\nreplace-with-base64\n-----END PUBLIC KEY-----
QUEUE_JWT_KEY_ID=queue-key-1
JWT_ISSUER=https://replace-with-domain
JWT_AUDIENCE=ticket-api
# Google Cloud Console OAuth 클라이언트(웹 애플리케이션). 리디렉션 URI는 Console의 승인된 리디렉션 URI와 같아야 한다.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://replace-with-domain/api/auth/google/callback
# 기본값 true. 로컬 http 개발에서만 false
AUTH_COOKIE_SECURE=true
# 기본 pessimistic. 근거: backend/loadtest/results/strategy_comparison.md
TICKET_PURCHASE_STRATEGY=pessimistic
